<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>voxblox_ros</name>
  <version>2.0.0</version>
  <description>ROS 2 Humble interface for Voxblox (TsdfServer, EsdfServer, Transformer)</description>
  <maintainer email="suhan.park@oprones.com">Suhan Park</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>minkindr</depend>
  <depend>voxblox</depend>
  <depend>voxblox_msgs</depend>
  <depend>libgoogle-glog-dev</depend>
  <depend>libgflags-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
